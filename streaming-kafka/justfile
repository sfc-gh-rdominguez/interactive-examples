set dotenv-load := true

# List recipes
default:
  @just --list

# Preflight: local tools, account + region, Interactive CDC enablement
doctor connection:
  @for t in docker python3 openssl jq snow; do command -v $t >/dev/null && echo "✓ $t" || echo "✗ $t missing"; done
  @docker compose version >/dev/null 2>&1 && echo "✓ docker compose" || echo "✗ docker compose missing"
  @command -v bun >/dev/null && echo "✓ bun" || echo "· bun missing (only needed for 'just web-dev')"
  @snow sql -c {{connection}} -f data/checks/00_preflight.sql || { echo "✗ cannot reach Snowflake via '{{connection}}' (VPN? connection name?)"; exit 1; }
  @if snow sql -c {{connection}} -f data/checks/00_cdc_probe.sql >/dev/null 2>&1; then echo "✓ Interactive CDC enabled"; else snow sql -c {{connection}} -q "DROP DATABASE IF EXISTS IA_CDC_PROBE_DB" >/dev/null 2>&1; echo "✗ Interactive CDC NOT enabled."; fi

# Run any check file: just check <connection> 05_table_ready
check connection name:
  snow sql -c {{connection}} -f data/checks/{{name}}.sql


# Generate an unencrypted PKCS#8 key pair for the service user
keys:
  mkdir -p keys
  openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out keys/rsa_key.p8 -nocrypt
  openssl rsa -in keys/rsa_key.p8 -pubout -out keys/rsa_key.pub
  chmod 600 keys/rsa_key.p8

# SHA256 fingerprint of the local public key, to compare with DESC USER
fingerprint:
  @echo "SHA256:$(openssl rsa -pubin -in keys/rsa_key.pub -outform DER 2>/dev/null | openssl dgst -sha256 -binary | openssl enc -base64)"

# Role, database, schema, standard warehouse
setup connection:
  snow sql -c {{connection}} -f data/migrations/001_init.sql

# Service user with the local public key injected into the migration
service-user connection:
  sed "s|__SVC_PUBLIC_KEY__|$(grep -v -- '-----' keys/rsa_key.pub | tr -d '\n')|g" data/migrations/002_service_user.sql > /tmp/iak_002.sql
  snow sql -c {{connection}} -f /tmp/iak_002.sql
  rm -f /tmp/iak_002.sql

# CDC-enabled interactive table, which is where our kafka topic will stream into
events-table connection:
  snow sql -c {{connection}} -f data/migrations/003_events_table.sql

# Interactive warehouse with the events table attached
iwh connection:
  snow sql -c {{connection}} -f data/migrations/004_interactive_wh.sql

# Download connector v4, start Kafka + Connect, create the topic
kafka-up:
  mkdir -p plugins/snowflake
  test -f plugins/snowflake/snowflake-kafka-connector-${KC_VERSION}.jar || curl -fL -o plugins/snowflake/snowflake-kafka-connector-${KC_VERSION}.jar https://repo1.maven.org/maven2/com/snowflake/snowflake-kafka-connector/${KC_VERSION}/snowflake-kafka-connector-${KC_VERSION}.jar
  test -f plugins/snowflake/bc-fips-2.1.0.jar || curl -fL -o plugins/snowflake/bc-fips-2.1.0.jar https://repo1.maven.org/maven2/org/bouncycastle/bc-fips/2.1.0/bc-fips-2.1.0.jar
  test -f plugins/snowflake/bcpkix-fips-2.1.8.jar || curl -fL -o plugins/snowflake/bcpkix-fips-2.1.8.jar https://repo1.maven.org/maven2/org/bouncycastle/bcpkix-fips/2.1.8/bcpkix-fips-2.1.8.jar
  docker compose up -d zookeeper kafka connect; until curl -sf localhost:8083/ >/dev/null; do sleep 3; done
  docker compose exec kafka kafka-topics --bootstrap-server localhost:9092 --create --if-not-exists --topic ${KAFKA_TOPIC} --partitions 3 --replication-factor 1

# Confirm Connect loaded the Snowflake plugin
kafka-plugins:
  curl -s localhost:8083/connector-plugins | jq -r '.[].class' | grep -i snowflake


# Register (or update) the sink connector: topic -> AUDIT_EVENTS
sink-add:
  chmod +x scripts/register_sink.sh
  ./scripts/register_sink.sh

# Connector + task states
sink-status:
  curl -s localhost:8083/connectors/ia-events-sink/status | jq '{connector: .connector.state, tasks: [.tasks[].state]}'

# Python venv for producer + probe
# Wheels for snowflake-connector-python and confluent-kafka stop at 3.14
venv py="python3.14":
  {{py}} -m venv --clear .venv
  .venv/bin/pip install -q -r scripts/requirements.txt

# Produce synthetic events: just produce --count 1000 --dup-rate 0.3
produce *args:
  .venv/bin/python scripts/produce.py {{args}}

# Egress -> visible latency: just probe --dedup LATEST_DEDUP
probe *args:
  .venv/bin/python scripts/probe.py {{args}}

# All three scan modes, back to back
probe-all:
  just probe --dedup LATEST_DEDUP
  just probe --dedup LATEST_ALL
  just probe --dedup LAST_DEDUP --runs 2

# Interactive MV on the CDC table (experiment; allowed to fail)
rollups connection:
  -snow sql -c {{connection}} -f data/migrations/005_rollups.sql

# 180-day storage lifecycle policy
retention connection:
  snow sql -c {{connection}} -f data/migrations/006_retention.sql

# Separate key pair for the dashboard's read-only service user
dash-keys:
  mkdir -p keys
  openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out keys/dash_key.p8 -nocrypt
  openssl rsa -in keys/dash_key.p8 -pubout -out keys/dash_key.pub
  chmod 600 keys/dash_key.p8
  @echo "SHA256:$(openssl rsa -pubin -in keys/dash_key.pub -outform DER 2>/dev/null | openssl dgst -sha256 -binary | openssl enc -base64)"

# Read-only role + user for the dashboard, and the fallback warehouse
dashboard-user connection:
  sed "s|__DASH_PUBLIC_KEY__|$(grep -v -- '-----' keys/dash_key.pub | tr -d '\n')|g" data/migrations/007_dashboard.sql > /tmp/iak_007.sql
  snow sql -c {{connection}} -f /tmp/iak_007.sql
  rm -f /tmp/iak_007.sql

# Build + start the dashboard BFF
api-up:
  docker compose up -d --build api

# Tail BFF logs
api-logs:
  docker compose logs -f api

# Build + start the dashboard (BFF + SPA) at http://localhost:8000
app-up:
  docker compose up -d --build api web

# Hot-reload the SPA locally against the BFF container (http://localhost:5173)
web-dev:
  cd web && bun install && bun run dev

# Pause for the day: stop containers, suspend the interactive warehouse (it bills while running)
stop connection:
  docker compose stop
  -snow sql -c {{connection}} -q "USE ROLE IA_LAB_RL; ALTER WAREHOUSE IA_LAB_IWH SUSPEND"

# Remove everything: the sink, all containers + volumes + built images, and every Snowflake object
[confirm("Drop IA_LAB, both IA_LAB warehouses, the IA_*_SVC users and IA_*_RL roles, and all local containers? [y/N]")]
teardown connection:
  -curl -s -X DELETE localhost:8083/connectors/ia-events-sink
  docker compose down -v --rmi local --remove-orphans
  snow sql -c {{connection}} -f data/teardown/teardown.sql
  @echo "Done. Confirm nothing is left: just check {{connection}} 16_teardown"

# Delete generated local files: keys, the connector JARs, the venv, and JS build output (keeps .env)
[confirm("Delete keys/, plugins/, .venv/, web/node_modules/ and web/dist/? [y/N]")]
clean-local:
  rm -rf keys plugins .venv web/node_modules web/dist api/node_modules scripts/__pycache__
